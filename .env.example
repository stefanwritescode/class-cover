# Copy to .env.local (and add the same in Vercel > Settings > Environment Variables).
# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret, server only. Supabase: Project Settings > API keys > service_role / secret key
SUPABASE_SERVICE_ROLE_KEY=

# Public address used in WhatsApp links
SITE_URL=https://class-cover-five.vercel.app

# ManyChat: Settings > API (workspace API key), and the automation's ID from its URL (content2026...)
MANYCHAT_API_KEY=
MANYCHAT_COVER_FLOW_NS=
